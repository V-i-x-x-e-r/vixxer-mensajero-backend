# Copia este archivo a .env y llena los valores reales. El .env no se sube al
# repo. Si agregas una variable al codigo, agregala aqui tambien.
#
# En el servidor, el .env debe quedar en modo 600: contiene la llave que abre
# la base entera y el secreto con el que se firman las sesiones.

# ---------- Supabase ----------
# Dashboard > Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave service_role: omite RLS, abre toda la base. Solo en el backend, jamas
# en el cliente.
SUPABASE_SERVICE_ROLE_KEY=reemplazar_por_la_service_role_key_real

# ---------- Sesiones ----------
# Aleatorio largo. Genera uno con: openssl rand -base64 48
# Quien lo tenga puede firmar un token valido de cualquier usuario.
JWT_SECRET=reemplaza_por_un_string_aleatorio_largo_y_secreto
# Opcional, HS256 por defecto.
JWT_ALG=HS256

# ---------- Notificaciones push (opcional) ----------
# JSON de la cuenta de servicio de Firebase, minificado en una sola linea.
# Sin esta variable el envio por FCM no opera y el resto sigue funcionando.
FIREBASE_CREDENCIALES=

# Variables de entorno del backend. Copia este archivo a .env y llena los valores
# reales. Nunca subas el .env al repo. Si agregas una variable, actualiza este .example.

# ---------- Servidor ----------
PORT=8000
# development | staging | production
APP_ENV=development

# ---------- Supabase ----------
# Dashboard > Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave service_role (PRIVADA, bypass RLS). Solo en el backend, jamas en el cliente.
SUPABASE_SERVICE_ROLE_KEY=reemplazar_por_la_service_role_key_real

# ---------- JWT ----------
# Secret aleatorio largo (>=32 chars). Genera uno con: openssl rand -base64 48
JWT_SECRET=reemplaza_por_un_string_aleatorio_largo_y_secreto
JWT_EXPIRES_IN=7d

# ---------- CORS ----------
# Origenes permitidos, separados por coma (sin espacios)
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# ---------- Logging ----------
# debug | info | warning | error
LOG_LEVEL=debug

# ---------- Seguridad ----------
# Costo de hashing bcrypt (10-12 recomendado)
BCRYPT_ROUNDS=12

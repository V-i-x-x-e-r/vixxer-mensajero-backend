# ============================================
# VIXXER MENSAJERO - BACKEND
# Variables de entorno del servidor
# ============================================
# 1. Copia este archivo a .env (sin el .example)
# 2. Llena los valores reales
# 3. NUNCA subas el archivo .env real al repo
# 4. Si agregas variables nuevas, actualiza este .example
# ============================================

# ---------- Servidor ----------
PORT=3000

# Entorno: development | staging | production
NODE_ENV=development

# ---------- Base de datos: Supabase ----------
# Obten estos valores en:
# Supabase Dashboard > tu proyecto > Project Settings > API
#
# SUPABASE_URL: URL publica de tu proyecto
SUPABASE_URL=https://tu-proyecto.supabase.co

# SUPABASE_ANON_KEY: Clave anonima (publica, segura para el cliente)
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxx

# SUPABASE_SERVICE_ROLE_KEY: Clave de servicio (PRIVADA, bypass RLS)
# NUNCA exponer al cliente ni subirla al repo
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxx

# ---------- Autenticacion JWT ----------
# Secret aleatorio largo (minimo 32 caracteres)
# Genera uno con: openssl rand -base64 64
# O en PowerShell: [Convert]::ToBase64String((1..64 | %{Get-Random -Maximum 256}))
JWT_SECRET=reemplaza_este_valor_por_un_string_aleatorio_largo_y_secreto

# Duracion del token: 7d, 24h, 30m, etc.
JWT_EXPIRES_IN=7d

# ---------- CORS ----------
# Origenes permitidos, separados por coma (sin espacios)
# En desarrollo, Expo Web puede correr en varios puertos
CORS_ORIGIN=http://localhost:8081,http://localhost:19000,http://localhost:19006

# ---------- Logging ----------
# Nivel: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ---------- Rate limiting ----------
# Limite de peticiones por IP por ventana
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---------- Bcrypt ----------
# Salt rounds para hashing de passwords (10-12 recomendado)
BCRYPT_SALT_ROUNDS=10

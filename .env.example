# ============================================
# VIXXER MENSAJERO - BACKEND (Python + FastAPI)
# Variables de entorno del servidor
# ============================================
# 1. Copia este archivo a .env (sin el .example)
# 2. Llena los valores reales
# 3. NUNCA subas el archivo .env real al repo
# 4. Si agregas variables nuevas, actualiza este .example
# ============================================

# ---------- Servidor ----------
PORT=8000
# Entorno: development | staging | production
APP_ENV=development

# ---------- Base de datos: Supabase ----------
# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave service_role (PRIVADA, bypass RLS). Solo en el backend, jamas en el cliente.
SUPABASE_SERVICE_ROLE_KEY=reemplazar_por_la_service_role_key_real

# ---------- Autenticacion JWT ----------
# Secret aleatorio largo (minimo 32 caracteres). Genera uno con:
#   openssl rand -base64 48
JWT_SECRET=reemplaza_por_un_string_aleatorio_largo_y_secreto
JWT_EXPIRES_IN=7d

# ---------- CORS ----------
# Origenes permitidos, separados por coma (sin espacios)
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# ---------- Logging ----------
# Nivel: debug | info | warning | error
LOG_LEVEL=debug

# ---------- Seguridad ----------
# Costo de hashing de passwords con bcrypt (10-12 recomendado)
BCRYPT_ROUNDS=12
